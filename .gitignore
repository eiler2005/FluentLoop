# --- Secrets & local config ---
# Convention: confidential data lives in secrets/ (gitignored entirely).
# `secrets/fluentloop.env` is the ready-to-copy source for the local .env.
# Never commit anything inside secrets/. See AGENTS.md "Secrets & privacy".
.env
.env.*
!.env.example
secrets/
*.session
*.session-journal

# --- Local user data (lesson notes, progress, AI outputs) ---
data/
state/
reports/
feedback_disputes/

# --- Night-run artefacts ---
# scripts/env_template.txt is committed as a TEMPLATE only. If you ever
# fill it with real values locally, rename or move it; never commit values.
# NIGHT_QUESTIONS.md and MORNING_REPORT.md are committed (handoff artefacts).
# usage_log.jsonl lives under data/ (already ignored above).

# --- Databases ---
*.sqlite
*.sqlite3
*.db
*.db-journal

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.tox/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Build artefacts ---
build/
dist/
*.egg

# --- Docker volumes mounted locally ---
.docker-data/

# --- Claude Code: keep settings.json, ignore local overrides ---
.claude/settings.local.json
.claude/cache/

# Agent scratch dirs
.qwen/
