# FluentLoop — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Telegram Bot API
# ---------------------------------------------------------------------------
# Create a bot via @BotFather in Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>

# Optional: restrict bot to a single Telegram user ID (single-user MVP).
# Get your numeric ID from @userinfobot. Leave empty during early testing.
TELEGRAM_ALLOWED_USER_ID=<your-telegram-user-id>

# ---------------------------------------------------------------------------
# AI provider — see docs/adr/0003-ai-model-tiering-and-cost.md
# ---------------------------------------------------------------------------
# One of: openai | anthropic
AI_PROVIDER=anthropic

# OpenAI keys (used only if AI_PROVIDER=openai)
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o

# Anthropic keys (used only if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite path relative to /app inside the container (mounted as ./data).
DB_URL=sqlite:////app/data/fluentloop.sqlite

# ---------------------------------------------------------------------------
# Scheduling & locale
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Moscow
REMINDER_TIME_DEFAULT=20:00
PRACTICE_DURATION_MINUTES=15

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
