# FluentLoop — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Telegram (Telethon in bot mode — see docs/adr/0002-telegram-library-choice.md)
# ---------------------------------------------------------------------------
# Telethon speaks MTProto, so it needs api_id + api_hash even when running
# in bot mode (with a bot token instead of a phone number).
# Get api_id / api_hash from https://my.telegram.org → API development tools.
TELEGRAM_API_ID=<telegram-app-api-id>
TELEGRAM_API_HASH=<telegram-app-api-hash>

# Create a bot via @BotFather in Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>

# Optional: restrict bot to one admitted Telegram user ID for this deployment.
# Get your numeric ID from @userinfobot. Leave empty only during early testing.
TELEGRAM_ALLOWED_USER_ID=<your-telegram-user-id>

# Optional private channel target for practice posts. For private channels,
# discover via scripts/discover_channel.py after the bot sees a channel event.
TELEGRAM_CHANNEL_TITLE=FluentLoop English
TELEGRAM_CHANNEL_ID=

# Optional forum supergroup workspace. When configured, the bot posts the
# working practice flow into real Telegram topics via message_thread_id.
TELEGRAM_FORUM_TITLE=FluentLoop English Forum
TELEGRAM_FORUM_GROUP_ID=
TELEGRAM_TOPIC_HELP_ID=
TELEGRAM_TOPIC_PRACTICE_FLOW_ID=
TELEGRAM_TOPIC_MATERIALS_UPLOAD_ID=
TELEGRAM_TOPIC_FEEDBACK_ID=
TELEGRAM_TOPIC_NEXT_PROMPT_ID=
TELEGRAM_TOPIC_SUMMARY_ID=
TELEGRAM_TOPIC_MISTAKES_ID=
TELEGRAM_TOPIC_STATS_ID=

# ---------------------------------------------------------------------------
# AI provider — see docs/adr/0003-ai-model-tiering-and-cost.md
#                and docs/adr/0010-multi-provider-llm-gateway.md
# ---------------------------------------------------------------------------
# OpenAI, DeepSeek, and Qwen are wired through provider abstractions. For the
# current learning-engine roadmap, set AI_PROVIDER=deepseek when
# DEEPSEEK_API_KEY is available; deterministic/stub fallbacks remain available
# for local tests. Valid values: stub | openai | deepseek | qwen.
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o

# DeepSeek (learning engine roadmap provider; OpenAI-compatible API).
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Backward-compatible default used if task-specific models are unset.
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PLANNER_MODEL=deepseek-v4-pro
DEEPSEEK_EXTRACTOR_MODEL=deepseek-v4-pro
DEEPSEEK_PLANNER_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

# Qwen (OpenAI-compatible DashScope endpoint). Only used when AI_PROVIDER=qwen.
# Must be a PAY-AS-YOU-GO key. A Token Plan key targets a different host and
# returns 404 for the flash models.
# DASHSCOPE_API_KEY is accepted as a fallback name for QWEN_API_KEY.
QWEN_API_KEY=<qwen-pay-as-you-go-key>
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Model Studio international list price per 1M input/output, checked Aug 2026:
#   qwen3.7-flash  CNY  0.225 /  0.974   <- newest flash, and the cheapest
#   qwen3.6-flash  CNY  1.874 / 11.241   (~8x qwen3.7-flash)
#   qwen3.8-max    CNY 14.988 / 44.965   (~66x input cost of flash)
# Every FluentLoop LLM task returns a Pydantic-validated schema, i.e. bounded
# JSON - the class flash handles well. Nothing here is free-form synthesis, so
# flash is the default everywhere. Raise PLANNER to qwen3.8-max only if lesson
# plans measurably degrade.
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_FAST_MODEL=qwen3.7-flash
QWEN_PLANNER_MODEL=qwen3.7-flash
QWEN_EXTRACTOR_MODEL=qwen3.7-flash
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite path relative to /app inside the container (mounted as ./data).
DB_URL=sqlite:////app/data/fluentloop.sqlite

# ---------------------------------------------------------------------------
# Scheduling & locale
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Moscow
REMINDER_TIME_DEFAULT=20:00
PRACTICE_DURATION_MINUTES=15

# Overnight pre-generation of the next day's session (ADR-0004).
# Fires at PRE_GEN_HOUR:PRE_GEN_MINUTE in the user's TZ.
PRE_GEN_HOUR=3
PRE_GEN_MINUTE=0

# Daily SQLite backup time (per EPIC-08).
BACKUP_HOUR=4
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=14

# Daily vocabulary loop (EPIC-25). Slot times are per user in /settings; this
# only controls the delivery format of the evening quiz. Set to 0 to fall back
# to inline buttons instead of native Telegram quiz polls (ADR-0011).
VOCAB_QUIZ_POLLS=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
